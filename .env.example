# Application Settings
APP_ENV=production
APP_DEBUG=false
SITE_NAME="Wonnegauer Designwerkstatt"
BASE_URL=""
CANONICAL_DOMAIN="https://www.wonnegauer-designwerkstatt.de"

# Cloudflare Turnstile (Bot & Anti-Scraping Protection)
# In development/testing, you can use the official Cloudflare test keys:
# Site Key: 1x00000000000000000000AA (Always passes)
# Secret Key: 1x0000000000000000000000000000000AA (Always passes)
# For production, register a widget at https://dash.cloudflare.com/ and insert keys below:
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

